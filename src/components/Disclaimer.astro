---
import type { Lang } from "../lib/categories";
import { t } from "../i18n/ui";

const { lang } = Astro.props as { lang: Lang };
---

<p class="disclaimer" role="note">{t(lang, "disclaimer")}</p>

<style>
  .disclaimer {
    background: var(--warn-bg);
    color: var(--warn-fg);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    margin: 0 0 1.5rem;
    font-size: 0.9rem;
  }
</style>
